prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: uiframework
Description: High-performance, thread-safe C++17 UI framework built on SDL2
Version: @PROJECT_VERSION@
Requires: sdl2 SDL2_ttf SDL2_image
Libs: -L${libdir} -luiframework
Cflags: -I${includedir}
